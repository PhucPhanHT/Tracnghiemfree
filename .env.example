# Cổng chạy ứng dụng (Mặc định: 3000)
PORT=3000

# Cấu hình kết nối cơ sở dữ liệu PostgreSQL (Tùy chọn)
# Để trống nếu muốn dùng SQLite cục bộ (data/uniprep.db)
# Cú pháp Local: postgres://<tên_user>:<mật_khẩu>@localhost:5432/<tên_database>
# Cú pháp Cloud (Render / Neon / Supabase): postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Google Gemini API Key để kích hoạt Trợ lý Học tập AI trực tiếp (Tùy chọn)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
# Nếu để trống, hệ thống sẽ tự động dùng chế độ Trợ lý Gia sư AI Offline
GEMINI_API_KEY=